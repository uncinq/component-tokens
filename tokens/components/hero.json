{
  "hero": {
    "color": {
      "background": {
        "$value": "{color.background.default}",
        "$type": "color"
      },
      "link": {
        "$value": "{color.text.default}",
        "$type": "color"
      },
      "text": {
        "$value": "{color.text.default}",
        "$type": "color"
      }
    },
    "gap": {
      "$value": "{spacing.sm}",
      "$type": "dimension"
    },
    "height": {
      "$value": "clamp(25rem, 23.2394rem + 7.5117vw, 30rem)",
      "$type": "dimension"
    },
    "home": {
      "height": {
        "$value": "clamp(30rem, 26.4789rem + 15.0235vw, 40rem)",
        "$type": "dimension"
      }
    },
    "media": {
      "brightness": {
        "$value": 0.3,
        "$type": "number"
      }
    },
    "maxHeight": {
      "$value": "calc(100vh - {header.height})",
      "$type": "dimension"
    },
    "padding": {
      "block": {
        "$value": "{spacing.md}",
        "$type": "dimension"
      },
      "inline": {
        "$value": "0px",
        "$type": "dimension"
      }
    },
    "title": {
      "color": {
        "$value": "{color.text.default}",
        "$type": "color"
      },
      "fontSize": {
        "$value": "{fontSize.heading.01}",
        "$type": "dimension"
      }
    }
  }
}
