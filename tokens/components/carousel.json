{
  "carousel": {
    "arrow": {
      "border": {
        "width": {
          "$type": "dimension",
          "$value": "{border.width.sm}"
        }
      },
      "borderRadius": {
        "$type": "dimension",
        "$value": "{radius.pill}"
      },
      "color": {
        "default": {
          "$type": "color",
          "$value": "{color.link.default}"
        },
        "background": {
          "default": {
            "$type": "color",
            "$value": "transparent"
          },
          "hover": {
            "$type": "color",
            "$value": "transparent"
          }
        },
        "border": {
          "default": {
            "$type": "color",
            "$value": "{color.link.default}"
          },
          "hover": {
            "$type": "color",
            "$value": "{color.link.hover}"
          }
        },
        "hover": {
          "$type": "color",
          "$value": "{color.link.hover}"
        }
      },
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.xs}"
      },
      "icon": {
        "default": {
          "$type": "string",
          "$value": "{icon.arrow}"
        },
        "size": {
          "$type": "dimension",
          "$value": "{icon.size}"
        }
      },
      "marginBlock": {
        "$type": "dimension",
        "$value": "{spacing.sm}"
      },
      "marginInline": {
        "$type": "dimension",
        "$value": "{spacing.xs}"
      },
      "opacity": {
        "disabled": {
          "$type": "number",
          "$value": "{opacity.disabled}"
        }
      },
      "size": {
        "$type": "dimension",
        "$value": "{spacing.lg}"
      }
    },
    "pagination": {
      "border": {
        "style": {
          "$type": "string",
          "$value": "{border.style.normal}"
        },
        "width": {
          "$type": "dimension",
          "$value": "{border.width.sm}"
        }
      },
      "borderRadius": {
        "$type": "dimension",
        "$value": "{radius.pill}"
      },
      "color": {
        "default": {
          "$type": "color",
          "$value": "{color.neutral.default}"
        },
        "active": {
          "$type": "color",
          "$value": "{color.active}"
        },
        "border": {
          "default": {
            "$type": "color",
            "$value": "transparent"
          },
          "active": {
            "$type": "color",
            "$value": "transparent"
          },
          "hover": {
            "$type": "color",
            "$value": "transparent"
          }
        },
        "hover": {
          "$type": "color",
          "$value": "{color.neutral.hover}"
        }
      },
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.2xs}"
      },
      "height": {
        "$type": "dimension",
        "$value": "{spacing.xs}"
      },
      "marginBlock": {
        "$type": "dimension",
        "$value": "{spacing.sm}"
      },
      "width": {
        "$type": "dimension",
        "$value": "{spacing.xs}"
      }
    }
  }
}
