{
  "details": {
    "border": {
      "radius":  {
        "$value": "{radius.surface}",
        "$type": "dimension"
      },
      "style":   {
        "$value": "{border.style.normal}",
        "$type": "strokeStyle"
      },
      "width":   {
        "$value": "{border.width.sm}",
        "$type": "dimension"
      }
    },
    "boxShadow": {
      "default": { 
        "$value": "{shadow.sm}", 
        "$type": "shadow" 
      },
      "hover":   { 
        "$value": "{shadow.md}", 
        "$type": "shadow" 
      }
    },
    "color": {
      "background": { 
        "$value": "{color.background.default}", 
        "$type": "color" 
      },
      "border": {
        "default": { 
          "$value": "{color.border.default}", 
          "$type": "color" 
        },
        "open":    { 
          "$value": "{color.border.hover.default}", 
          "$type": "color" 
        }
      },
      "text": {
        "$value": "{color.text.default}", 
        "$type": "color" 
      }
    },
    "icon": {
      "default": {
        "$value": "{icon.chevron}",
        "$type": "string"
      },
      "open":    {
        "$value": "{details.icon.default}",
        "$type": "string"
      },
      "rotate": {
        "open": {
          "$value": "180deg",
          "$type": "string"
        }
      },
      "size":    {
        "$value": "{icon.size}",
        "$type": "dimension"
      },
      "transition": {
        "$value": "rotate {duration.normal} {easing.default}",
        "$type": "string"
      }
    },
    "margin":  { 
      "$value": "{spacing.sm}", 
      "$type": "dimension" 
    },
    "content": {
      "align": {
        "$value": "start",
        "$type": "string"
      },
      "fontSize": {
        "$value": "{fontSize.text}",
        "$type": "dimension"
      },
      "padding": {
        "inline": {
          "$value": "{spacing.sm}",
          "$type": "dimension"
        },
        "block": {
          "$value": "{spacing.sm}",
          "$type": "dimension"
        }
      }
    },
    "summary": {
      "fontFamily": {
        "$value": "{fontFamily.heading}",
        "$type": "fontFamily"
      },
      "fontSize": {
        "$value": "{fontSize.md}",
        "$type": "dimension"
      },
      "fontWeight": {
        "$value": "{fontWeight.heading}",
        "$type": "fontWeight"
      },
      "padding": {
        "inline": {
          "$value": "{spacing.sm}",
          "$type": "dimension"
        },
        "block": {
          "$value": "{spacing.sm}",
          "$type": "dimension"
        }
      }
    },
    "transition": {
      "$value": "{transition.normal}",
      "$type": "string"
    }
  }
}
