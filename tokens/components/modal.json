{
  "modal": {
    "backdrop": {
      "blur": {
        "$value": "{blur.backdrop}",
        "$type": "dimension"
      },
      "color": {
        "$value": "{color.backdrop}",
        "$type": "color"
      }
    },
    "border": {
      "style":   { 
        "$value": "{border.style.normal}", 
        "$type": "strokeStyle" 
      },
      "width":   { 
        "$value": "{border.width.sm}", 
        "$type": "dimension" 
      }
    },
    "color": {
      "background": {
        "$value": "{color.background.surface}",
        "$type": "color"
      },
      "border": {
        "$value": "{color.border.default}",
        "$type": "color"
      },
      "text": {
        "$value": "{color.text.onSurface}",
        "$type": "color"
      }
    },
    "margin": {
      "$value": "{spacing.sm}",
      "$type": "dimension"
    },
    "maxHeight": {
      "$value": "100dvh",
      "$type": "dimension"
    },
    "maxWidth": {
      "$value": "30rem",
      "$type": "dimension"
    },
    "padding": {
      "block": {
        "$value": "{spacing.surface}",
        "$type": "dimension"
      },
      "inline": {
        "$value": "{spacing.surface}",
        "$type": "dimension"
      }
    },
    "radius": {
      "$value": "{radius.surface}",
      "$type": "dimension"
    },
    "shadow": {
      "$value": "{shadow.surface}",
      "$type": "shadow"
    },
    "transition": {
      "duration": {
        "$value": "{duration.slow}",
        "$type": "duration"
      },
      "easing": {
        "$value": "{easing.out-expo}",
        "$type": "string"
      }
    },
    "translate": {
      "$value": "translateY(1rem)",
      "$type": "string"
    },
    "zIndex": {
      "$value": "{zIndex.modal}",
      "$type": "number"
    }
  }
}
