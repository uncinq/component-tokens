{
  "surtitle": {
    "color": {
      "text": {
        "$value": "{color.text.muted}",
        "$type": "color"
      }
    },
    "fontSize": {
      "$value": "{fontSize.xs}",
      "$type": "dimension"
    },
    "fontWeight": {
      "$value": "{fontWeight.bold}",
      "$type": "fontWeight"
    },
    "letterSpacing": {
      "$value": "{letterSpacing.md}",
      "$type": "dimension"
    },
    "lineHeight": {
      "$value": "{lineHeight.normal}",
      "$type": "number"
    },
    "margin": {
      "block": {
        "end": {
          "$value": "{spacing.2xs}",
          "$type": "dimension"
        },
        "start": {
          "$value": "0",
          "$type": "dimension"
        }
      }
    },
    "textTransform": {
      "$value": "uppercase",
      "$type": "string"
    }
  }
}
